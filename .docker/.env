# Interpolation default for the CI override flow (docker-compose.ci.yml).
#
# Compose interpolates EVERY file before merging, so the :ci image override
# cannot by itself remove the ${IMAGE_TAG:?} requirement that lives in
# docker-compose-prod.yml — but this file is auto-loaded (the project dir is
# the first -f file's directory), which satisfies the interpolation bare:
#   docker compose -f .docker/docker-compose-prod.yml \
#     -f .docker/docker-compose.ci.yml config -q
#
# NOT a secret: one non-sensitive interpolation variable, committed on
# purpose (this repo has no .gitignore excluding it). An explicit IMAGE_TAG
# in the environment always wins — the deploy's versioned releases are
# unaffected.
IMAGE_TAG=ci
